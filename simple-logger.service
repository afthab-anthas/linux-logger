[Unit]
Description=My Custom Resource Logger Service
After=network.target

[Service]
# The user monitoring the system. usually 'root' or your username.
User=admin
WorkingDirectory=/home/admin/repos/linux-logger/

# The command to run
ExecStart=/usr/bin/python3 /home/admin/repos/linux-logger/monitor.py

# If it crashes, restart it automatically
Restart=always
RestartSec=3

[Install]
# This makes it start when the computer boots up
WantedBy=multi-user.target
